# Runtime state. NEVER commit any of this.
#
# .runwall/ holds operator.json (password hash + TOTP secret), client.token,
# approval.key, the chain anchor, and the decision ledger. The ledger contains
# prompts, file paths and tool arguments from every governed session -- it is
# the highest-value file the system produces and it is not shareable.
.runwall/
*.token
*.key
*.anchor
operator.json
gate_decisions.jsonl
spool.jsonl*
perimeter.json

# Generated by `runwall harden` -- contains machine-specific account and paths.
runwall-harden.ps1

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
